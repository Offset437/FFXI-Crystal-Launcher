// Home (Skyline): the hero over Vana'diel's sky (sky.slint), the look-up bar, the first-run
// checks when no account is added yet, and PlayOnline news (three cards and older headlines).
// The accounts and Play live in the rail (rail.slint) on every page. Sizes are the renders'
// (crystal-design-v12b, a-skyline), with the small window's below 1180 px (Theme.small).
import { Theme } from "theme.slint";
import { View, Ink, NewsCard, SetupStep } from "state.slint";
import { SkyHero } from "sky.slint";
import { Glyph, Icon, Pressable, SmallButton, IconButton, Field, Select, EmptyState, ScrollThumb, Banner, TipBody, SectionHeader, TextTab, NewsTile, NewsLine } from "widgets.slint";

/// The slim warning strip when a Windows component is missing (prereqs::banner). scale is the
/// layout scale: Home's, or 1 where a page draws it at full size (Downloads).
export component PrereqBanner inherits VerticalLayout {
    in property <float> scale: Theme.scale;
    private property <float> s: root.scale;
    private property <color> tone: View.banner-restart ? Theme.accent : Theme.warn-tone;
    Banner {
        tone: root.tone;
        glyph: View.banner-restart ? Glyph.refresh : Glyph.alert-circle;
        glyph-size: 15px * root.s;
        edge: 0.38;
        pad-left: Theme.sp-l * root.s;
        pad-right: 8px * root.s;
        pad-y: 0px;
        gap: Theme.sp-m * root.s;
        height: 44px * root.s;
        border-radius: Theme.radius-mid;
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            Text { text: View.banner-lead; font-size: Theme.type-small * root.s; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
            Text { text: View.banner-rest; font-size: Theme.type-small * root.s; color: Theme.ink2; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }
        fix := Pressable {
            label: View.banner-action;
            cross-axis-self-alignment: center;
            height: 28px * root.s;
            min-width: fix-row.preferred-width + 22px * root.s;
            horizontal-stretch: 0;
            border-radius: Theme.radius-inner;
            border-width: 1px;
            background: root.tone.mix(Theme.bg, self.hot ? 0.2 : 0.12);
            border-color: root.tone.mix(Theme.bg, 0.5);
            clicked => { View.banner-clicked(); }
            fix-row := HorizontalLayout {
                x: 11px * root.s;
                width: self.preferred-width;
                spacing: 6px * root.s;
                Text { text: View.banner-action; font-size: Theme.type-small * root.s; font-weight: 600; color: root.tone; vertical-alignment: center; }
                Icon { cross-axis-self-alignment: center; glyph: Glyph.arrow-right; size: 13px * root.s; tint: root.tone; }
            }
        }
    }
}

/// How far Home's page has scrolled: the window moves the sky band with it (crystal.slint).
export global HomeScroll {
    in-out property <length> offset;
}

/// The look-up bar (`.look`): the site switch (the wiki or FFXIAH), the search field, a link to
/// the site, and FFXIAH's world picker.
component LookBar inherits Rectangle {
    private property <bool> small: Theme.small;
    private property <bool> ah: View.look-scope == 1;
    private property <length> inner-h: root.small ? 28px : 32px;
    width: root.small ? 392px : 520px;
    height: root.small ? 40px : 44px;
    border-radius: 11px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.look;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 6px;
        spacing: 0px;
        // The site switch (`.seg`): segments sized to their words, the chosen one raised.
        Rectangle {
            cross-axis-self-alignment: center;
            width: seg.preferred-width;
            height: root.inner-h;
            border-radius: 8px;
            background: Theme.seg;
            accessible-role: tab-list;
            accessible-label: View.strings.look-up;
            seg := HorizontalLayout {
                padding: 2px;
                spacing: 0px;
                for site[index] in [View.strings.wiki-title, "FFXIAH"]: Pressable {
                    private property <bool> on: index == View.look-scope;
                    label: site;
                    accessible-role: tab;
                    accessible-checked: self.on;
                    width: caption.preferred-width + (root.small ? 18px : 22px);
                    border-radius: 6px;
                    border-width: self.on && Theme.light ? 1px : 0px;
                    border-color: Theme.hairline;
                    background: self.on ? Theme.fill2 : self.hot ? Theme.seg : transparent;
                    clicked => { View.look-scope = index; }
                    caption := Text {
                        text: site;
                        font-size: Theme.type-small;
                        font-weight: 600;
                        color: parent.on || parent.hot ? Theme.ink : Theme.sub;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle { width: root.small ? 10px : 12px; }
        if !root.ah: Field {
            framed: false;
            height: root.inner-h;
            cross-axis-self-alignment: center;
            glyph: Glyph.search;
            pad-x: 0px;
            font-size: Theme.type-body;
            placeholder: View.strings.wiki-placeholder;
            text <=> View.wiki-query;
            edited(value) => { View.wiki-edited(value); }
            accepted => { View.wiki-search(); }
        }
        if root.ah: Field {
            framed: false;
            height: root.inner-h;
            cross-axis-self-alignment: center;
            glyph: Glyph.search;
            pad-x: 0px;
            font-size: Theme.type-body;
            placeholder: View.strings.find-item;
            text <=> View.ah-query;
            edited(value) => { View.ah-edited(value); }
            accepted => { View.ah-search(); }
        }
        // The chosen site's own page.
        IconButton {
            cross-axis-self-alignment: center;
            side: root.small ? 26px : 28px;
            glyph: Glyph.external-link;
            glyph-size: 14px;
            ink: Theme.faint;
            hint: View.strings.open-website;
            clicked => { if root.ah { View.open-ffxiah(); } else { View.open-wiki(); } }
        }
        if root.ah: Rectangle { width: 6px; }
        if root.ah: Rectangle {
            cross-axis-self-alignment: center;
            width: 1px;
            height: root.inner-h;
            background: Theme.hairline;
        }
        if root.ah: Rectangle { width: 2px; }
        if root.ah: Select {
            cross-axis-self-alignment: center;
            width: self.fit-width;
            height: root.inner-h;
            framed: false;
            font-size: Theme.type-small;
            weight: 600;
            ink: Theme.ink2;
            glyph-ink: Theme.faint;
            hot-fill: Theme.fill;
            label: "FFXIAH";
            placeholder: "FFXIAH";
            items: View.ah-servers;
            current: View.ah-server;
            picked(index) => { View.ah-server-picked(index); }
        }
    }
}

/// The news header's link to the official news (`.all`): ice words and the external glyph.
component AllNews inherits Pressable {
    label: View.strings.view-all-news;
    accessible-role: button;
    horizontal-stretch: 0;
    width: row.preferred-width;
    row := HorizontalLayout {
        height: root.height;
        spacing: 6px;
        // The small window keeps the glyph alone: the tabs need the width.
        if !Theme.small: Text {
            text: View.strings.all-news;
            font-size: Theme.type-small;
            font-weight: 600;
            color: root.hot ? Theme.ice-hi : Theme.ice;
            vertical-alignment: center;
        }
        Icon { cross-axis-self-alignment: center; glyph: Glyph.external-link; size: 14px; tint: root.hot ? Theme.ice-hi : Theme.ice; }
    }
    if Theme.small: Tooltip { TipBody { text: View.strings.all-news; } }
}

/// PlayOnline news (`.news`): the header with its tabs, refresh and All news; three cards (two
/// in the small window) and the older headlines under them (none on first run).
component NewsSection inherits VerticalLayout {
    private property <int> cols: Theme.small ? 2 : 3;
    private property <length> gap: 20px;
    // The card's picture and its words: the teaser's two lines unless it has none (first run).
    private property <length> card-h: 84px + 12px + 16px + 5px + 22px + (View.first-run ? 0px : 4px + 36px);
    spacing: 0px;
    SectionHeader {
        title: View.strings.news;
        note: View.news-note;
        Rectangle { width: 8px; }
        HorizontalLayout {
            spacing: Theme.small ? 14px : 18px;
            horizontal-stretch: 0;
            for tab[index] in View.news-tabs: TextTab {
                text: tab;
                active: index == View.news-tab;
                clicked => { View.news-picked(index); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 12px;
            horizontal-stretch: 0;
            IconButton {
                cross-axis-self-alignment: center;
                side: 24px;
                glyph: Glyph.refresh;
                glyph-size: 14px;
                ink: Theme.faint;
                hint: View.strings.refresh-news;
                clicked => { View.refresh-news(); }
            }
            AllNews { clicked => { View.view-all-news(); } }
        }
    }
    Rectangle { height: 16px; }
    if View.news-state == 0: cards := HorizontalLayout {
        height: root.card-h;
        spacing: root.gap;
        alignment: start;
        for card[index] in View.news: NewsTile {
            width: (cards.width - root.gap * (root.cols - 1)) / root.cols;
            picture: card.image;
            has-picture: card.has-image;
            art: card.art;
            kind: card.kind;
            kind-ink: View.tone(card.kind-ink);
            date: card.date;
            title: card.title;
            teaser: card.teaser;
            surface: Theme.bg;
            clicked => { View.open-news(index); }
            // The whole headline over the elided one.
            label: card.headline;
            Tooltip { TipBody { text: card.headline; } }
        }
    }
    if View.news-state != 0: Rectangle {
        height: root.card-h;
        background: Theme.fill;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.hairline;
        VerticalLayout {
            alignment: center;
            padding-left: Theme.sp-l;
            padding-right: Theme.sp-l;
            EmptyState {
                glyph: View.news-state == 2 ? Glyph.alert-circle : Glyph.rss;
                busy: View.news-state == 1;
                title: View.news-empty-title;
                body: View.news-empty-body;
                action: View.news-state == 1 ? "" : View.strings.refresh-news;
                action-glyph: Glyph.refresh;
                act => { View.refresh-news(); }
            }
        }
    }
    if View.news-older.length > 0: Rectangle { height: 20px; }
    if View.news-older.length > 0: Rectangle { height: 1px; background: Theme.hairline; }
    for line[index] in View.news-older: NewsLine {
        kind: line.kind;
        kind-ink: View.tone(line.kind-ink);
        title: line.title;
        date: line.date;
        clicked => { View.open-news(View.news.length + index); }
    }
}

/// One first-run check (`.stp`): its glyph and name, its state, a path or count, one action.
component SetupCheck inherits VerticalLayout {
    in property <SetupStep> step;
    in property <bool> first;
    callback act();
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    padding-top: 18px;
    padding-bottom: 20px;
    padding-left: root.first ? 0px : 24px;
    padding-right: 24px;
    spacing: 0px;
    alignment: start;
    HorizontalLayout {
        height: 22px;
        spacing: 10px;
        alignment: start;
        Icon { cross-axis-self-alignment: center; glyph: root.step.glyph; size: 18px; tint: View.tone(root.step.ink); }
        Text { text: root.step.title; font-size: Theme.type-lead; font-weight: 600; color: Theme.ink; vertical-alignment: center; overflow: elide; }
    }
    Rectangle { height: 6px; }
    Text { height: 20px; text: root.step.body; font-size: Theme.type-state; color: Theme.ink2; vertical-alignment: center; overflow: elide; }
    Rectangle { height: 2px; }
    Text {
        height: 18px;
        text: root.step.detail;
        font-family: root.step.detail-mono ? Theme.mono : Theme.sans;
        font-size: Theme.type-fine;
        font-weight: 500;
        color: Theme.faint;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle { height: 14px; }
    HorizontalLayout {
        alignment: start;
        SmallButton {
            height: 32px;
            width: self.min-width + 4px;
            scale: 1;
            text: root.step.action;
            glyph: root.step.action-glyph;
            enabled: root.step.action-enabled;
            clicked => { root.act(); }
        }
    }
}

/// Home's first-run section (`.setup`, no accounts yet): the three checks between hairlines.
component SetupSection inherits VerticalLayout {
    spacing: 0px;
    SectionHeader { title: View.strings.before-you-play; }
    Rectangle { height: 16px; }
    Rectangle {
        height: steps.preferred-height;
        steps := HorizontalLayout {
            spacing: 0px;
            for step[index] in View.setup: HorizontalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                spacing: 0px;
                if index > 0: Rectangle { width: 1px; background: Theme.hairline; }
                SetupCheck {
                    step: step;
                    first: index == 0;
                    act => { View.setup-action(index); }
                }
            }
        }
        Rectangle { y: 0; height: 1px; background: Theme.hairline; }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.hairline; }
    }
}

/// Home's page under the top bar: the hero and look-up bar over the sky band (SkyBackdrop, drawn
/// by the window behind the bar and moved with this page's scroll), then the first-run checks
/// and the news.
export component HomePage inherits Rectangle {
    // Window offsets of the renders: the hero at 92 (76 small), the look-up bar at 300 (224),
    // the section under it at 432 (324); the page starts under the 44 px bar.
    private property <length> hero-top: (Theme.small ? 76px : 92px) - Theme.bar-h;
    private property <length> hero-h: Theme.small ? 112px : 136px;
    private property <length> look-top: (Theme.small ? 224px : 300px) - Theme.bar-h;
    private property <length> section-top: (Theme.small ? 324px : 432px) - Theme.bar-h;
    init => { HomeScroll.offset = 0; }
    page := Flickable {
        content-width: self.width;
        content-height: body.height;
        changed content-y => { HomeScroll.offset = max(0px, -self.content-y); }
        body := VerticalLayout {
            width: page.width;
            height: max(page.height, self.min-height);
            padding-top: root.hero-top;
            padding-bottom: 32px;
            padding-left: Theme.page-x;
            padding-right: Theme.page-x;
            spacing: 0px;
            SkyHero {
                height: root.hero-h;
                greeting: View.first-run ? View.strings.greeting-first : View.strings.greeting;
                serif: View.serif-greeting;
            }
            Rectangle { height: root.look-top - root.hero-top - root.hero-h; }
            HorizontalLayout { alignment: start; LookBar { } }
            Rectangle { height: root.section-top - root.look-top - (Theme.small ? 40px : 44px); }
            if View.first-run: SetupSection { }
            if View.first-run: Rectangle { height: 36px; }
            NewsSection { }
            Rectangle { vertical-stretch: 1; }
        }
    }
    ScrollThumb {
        x: parent.width - 8px;
        height: parent.height;
        content-y: page.content-y;
        content-height: page.content-height;
        visible-height: page.height;
    }
}
