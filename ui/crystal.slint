// Crystal Launcher's Slint front end (feature `slint-ui`). The core (`App` in src/main.rs) owns
// every piece of state; src/slint_host/view.rs pushes it into these properties after each
// message and turns these callbacks back into core messages. Every user-visible string comes
// from Rust (`i18n::t`), never from this markup.
import "../assets/fonts/SourceSans3-Regular.ttf";
import "../assets/fonts/SourceSans3-Medium.ttf";
import "../assets/fonts/SourceSans3-Semibold.ttf";
import "../assets/fonts/SourceSans3-Bold.ttf";
import "../assets/fonts/SourceSerif4-It.ttf";
import "../assets/fonts/JetBrainsMono-Medium.ttf";
import { Theme } from "theme.slint";
import { ChromeBar, ResizeEdges } from "chrome.slint";
import { View } from "state.slint";
import { TitleContent } from "titlebar.slint";
import { HomePage, HomeScroll } from "home.slint";
import { AccountRail } from "rail.slint";
import { Sky, SkyBackdrop } from "sky.slint";
import { AccountSheet } from "sheet.slint";
import { FriendsPage, FriendsView } from "friends.slint";
import { Downloads, DownloadsPage, SettingsDialog } from "downloads.slint";
import { LauncherUpdatesCard, WindowsComponents } from "downloads_system.slint";
import { SettingsPage, SettingsView } from "settings.slint";
import { CloseDialog, ImportDialog } from "settings_dialogs.slint";
import { Features, FeaturesPage, RelaunchBanner } from "features.slint";
import { Nav } from "widgets.slint";
import { Dialogs, DeleteDialog, DetailsDialog, AhDialog, PortraitDialog } from "dialogs.slint";

// Nav.modal is set with the account sheet and the launcher settings dialog
// (src/slint_host/downloads.rs): while either is open, the title bar, the page and the play bar
// are out of Tab's and the controller's reach.
export { Theme, View, FriendsView, Downloads, SettingsView, Features, Nav, Dialogs, Sky }

export component MainWindow inherits Window {
    // ---- the host's contract (src/slint_host/mod.rs) ----
    /// The window is maximised (the caption shows Restore, no resize edges).
    in property <bool> window-maximized;
    /// Caption buttons' accessible names.
    in property <string> minimize-label;
    in property <string> maximize-label;
    in property <string> restore-label;
    in property <string> close-label;
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();
    callback title-pressed();
    callback title-moved();
    callback title-released();
    /// A resize edge was grabbed (effect::Edge's order).
    callback resize-pressed(int);
    /// The window's logical size changed.
    callback resized(length, length);
    /// Escape that no control took (ControllerBack).
    callback escape();
    /// The taskbar and Alt+Tab icon (assets/crystal-icon-64.rgba).
    in property <image> window-icon;

    title: "Crystal Launcher";
    icon: root.window-icon;
    no-frame: true;
    min-width: 900px;
    min-height: 650px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.bg;
    default-font-family: Theme.sans;
    default-font-size: Theme.type-body;
    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }

    /// A dialog or sheet is over the window: the shortcuts below stand down.
    private property <bool> overlay: View.sheet-open || Downloads.settings-open
        || SettingsView.import-open || SettingsView.close-open || Dialogs.delete-open
        || Dialogs.details-open || Dialogs.ah-open || Dialogs.portrait-open || Nav.modal;

    /// A number key 1 to 9 on Home toggles that account's Play pick (no text field has the key:
    /// a field takes digits itself). Returns whether it was taken.
    public function number-key(n: int) -> bool {
        if root.overlay || Features.open || View.page != 0 || n < 1 || n > 9 || n > View.accounts.length { return false; }
        View.toggle-account(n - 1, !View.accounts[n - 1].checked);
        return true;
    }

    /// Return with nothing focused presses Play (its Enter cap). Returns whether it was taken.
    public function enter-key() -> bool {
        if root.overlay || !View.footer.play-enabled { return false; }
        View.main-action();
        return true;
    }

    // Every key a control rejects ends here: Escape goes back, a number key picks an account on
    // Home. It never takes the focus itself (not a Tab or controller stop); with nothing focused
    // the host's window listener does the same (src/slint_host/mod.rs).
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                let n = event.text == "1" ? 1 : event.text == "2" ? 2 : event.text == "3" ? 3
                    : event.text == "4" ? 4 : event.text == "5" ? 5 : event.text == "6" ? 6
                    : event.text == "7" ? 7 : event.text == "8" ? 8 : event.text == "9" ? 9 : 0;
                if n > 0 && root.number-key(n) { return accept; }
            }
            return reject;
        }
    // The main column is declared before the rail it sits beside, so Tab goes top bar, page,
    // then the rail with Play last (the former footer's place).
    Rectangle {
        Rectangle {
            x: Theme.rail-w;
            width: parent.width - Theme.rail-w;
            // Home's sky reaches up under the clear top bar and scrolls with the page.
            if View.page == 0 && !Features.open: SkyBackdrop { y: -min(HomeScroll.offset, Theme.sky-h); height: Theme.sky-h; }
            VerticalLayout {
                ChromeBar {
                    // Clear over the sky; the window colour once Home has scrolled past it.
                    flat: View.page != 0 || Features.open || HomeScroll.offset >= Theme.sky-h - Theme.bar-h;
                    maximized: root.window-maximized;
                    minimize-label: root.minimize-label;
                    maximize-label: root.maximize-label;
                    restore-label: root.restore-label;
                    close-label: root.close-label;
                    minimize-clicked => { root.minimize-clicked(); }
                    maximize-clicked => { root.maximize-clicked(); }
                    close-clicked => { root.close-clicked(); }
                    title-pressed => { root.title-pressed(); }
                    title-moved => { root.title-moved(); }
                    title-released => { root.title-released(); }
                    TitleContent { }
                }
                if View.page == 0 && !Features.open: HomePage { vertical-stretch: 1; }
                if Features.open: FeaturesPage { vertical-stretch: 1; }
                if View.page == 1 && !Features.open: FriendsPage { vertical-stretch: 1; }
                if View.page == 2 && !Features.open: DownloadsPage { vertical-stretch: 1; }
                if View.page == 3 && !Features.open: SettingsPage { vertical-stretch: 1; }
                // Crash recovery lists the same relaunches itself.
                if Features.relaunches.length > 0 && !(Features.open && Features.section == 2): RelaunchBanner { }
            }
        }
        AccountRail {
            x: 0;
            width: Theme.rail-w;
            title-pressed => { root.title-pressed(); }
            title-moved => { root.title-moved(); }
            title-released => { root.title-released(); }
        }
    }
    if View.sheet-open: AccountSheet { }
    if Downloads.settings-open: SettingsDialog { }
    if SettingsView.import-open: ImportDialog { }
    if SettingsView.close-open: CloseDialog { }
    if Dialogs.delete-open: DeleteDialog { }
    if Dialogs.details-open: DetailsDialog { }
    if Dialogs.ah-open: AhDialog { }
    if Dialogs.portrait-open: PortraitDialog { }
    if !root.window-maximized: ResizeEdges {
        resize-pressed(edge) => { root.resize-pressed(edge); }
    }
    }
}

/// Settings → System's Launcher updates and Windows components cards on their own, drawn from the
/// same view model: the headless tests and screenshots render them here until the Settings page
/// places them.
export component SystemCards inherits Window {
    background: Theme.bg;
    default-font-family: Theme.sans;
    default-font-size: Theme.type-body;
    preferred-width: 900px;
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: start;
        LauncherUpdatesCard { }
        WindowsComponents { }
    }
}
