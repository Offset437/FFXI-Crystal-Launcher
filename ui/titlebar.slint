// The top bar's content right of the account rail (Skyline `.top`): the page tabs, then Privacy
// mode and the theme switch as quiet icon tools and a separator before the caption buttons.
// Empty parts of it fall through to ChromeBar's title area, which drags the window.
import { Theme } from "theme.slint";
import { View } from "state.slint";
import { Features } from "features.slint";
import { Glyph, IconButton, Pressable, CountBadge } from "widgets.slint";

/// A page tab: 14 px in `sub`; the active one ink and semibold over a 2 px ice underline 6 px
/// above the bar's foot, as wide as its words.
component NavTab inherits Pressable {
    in property <string> text;
    in property <bool> active;
    in property <string> badge;
    label: root.text;
    accessible-role: tab;
    accessible-checked: root.active;
    height: Theme.bar-h;
    min-width: row.preferred-width;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    row := HorizontalLayout {
        spacing: 7px;
        caption := Text {
            text: root.text;
            font-size: Theme.type-body;
            font-weight: root.active ? 600 : 400;
            color: root.active || root.hot ? Theme.ink : Theme.sub;
            vertical-alignment: center;
        }
        if root.badge != "": CountBadge { cross-axis-self-alignment: center; text: root.badge; }
    }
    if root.active: Rectangle {
        x: 0;
        y: parent.height - 8px;
        width: caption.width;
        height: 2px;
        border-radius: 1px;
        background: Theme.ice;
    }
}

export component TitleContent inherits HorizontalLayout {
    alignment: stretch;
    padding-left: Theme.page-x;
    spacing: 0px;
    HorizontalLayout {
        spacing: Theme.small ? 18px : 28px;
        horizontal-stretch: 0;
        NavTab { text: View.strings.home; active: View.page == 0 && !Features.open; clicked => { View.navigate(0); } }
        NavTab { text: View.strings.friends; badge: View.friends-badge; active: View.page == 1 && !Features.open; clicked => { View.navigate(1); } }
        NavTab { text: View.strings.downloads; active: View.page == 2 && !Features.open; clicked => { View.navigate(2); } }
        NavTab { text: View.strings.features; active: Features.open; clicked => { Features.open-sheet(true); } }
        NavTab { text: View.strings.settings; active: View.page == 3 && !Features.open; clicked => { View.navigate(3); } }
    }
    // The tabs never run into the tools: at least a tab gap between them.
    Rectangle { horizontal-stretch: 1; min-width: Theme.small ? 12px : 28px; }
    IconButton {
        cross-axis-self-alignment: center;
        side: 30px;
        wide: 34px;
        glyph-size: 16px;
        glyph: View.privacy ? Glyph.eye-off : Glyph.eye;
        ink: View.privacy ? Theme.ice : Theme.sub;
        hint: View.privacy ? View.strings.privacy-on-tip : View.strings.privacy-off-tip;
        accessible-label: View.strings.privacy;
        accessible-checkable: true;
        accessible-checked: View.privacy;
        clicked => { View.toggle-privacy(); }
    }
    // One switch that names the theme it turns on.
    IconButton {
        cross-axis-self-alignment: center;
        side: 30px;
        wide: 34px;
        glyph-size: 16px;
        glyph: Theme.light ? Glyph.moon : Glyph.sun;
        hint: Theme.light ? View.strings.dark-theme : View.strings.light-theme;
        clicked => { View.toggle-theme(); }
    }
    Rectangle { width: 8px; }
    Rectangle {
        width: 1px;
        Rectangle { y: (parent.height - 16px) / 2; height: 16px; background: Theme.line; }
    }
    Rectangle { width: 6px; }
}
