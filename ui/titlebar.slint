// The title bar's content between the window's left edge and its caption buttons: the brand, the page tabs, Privacy mode and the theme switch. Empty parts of it fall
// through to ChromeBar's title area, which drags the window.
import { Theme } from "theme.slint";
import { View } from "state.slint";
import { Glyph, Icon, Pressable, TipBody } from "widgets.slint";

/// A title-bar tab: 14 px label, 12 px side padding; the active one is ink and semibold over a
/// 2 px underline in the Play colour, the rest muted.
component NavTab inherits Pressable {
    in property <string> text;
    in property <bool> active;
    label: root.text;
    accessible-checked: root.active;
    height: Theme.bar-h;
    min-width: caption.preferred-width + 24px;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    caption := Text {
        text: root.text;
        font-size: 14px;
        font-weight: root.active ? 600 : 500;
        color: root.active || root.hot ? Theme.ink : Theme.sub;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    if root.active: Rectangle {
        x: 12px;
        y: parent.height - 2px;
        width: parent.width - 24px;
        height: 2px;
        background: Theme.play;
    }
}

/// A labelled title-bar button (Privacy mode, the theme switch): glyph and 13 px label in the
/// quiet tone, a soft fill on hover, the soft accent fill while `on`. `compact` keeps the glyph
/// and moves the label into a hint.
component BarButton inherits Pressable {
    in property <Glyph> glyph;
    in property <string> text;
    in property <string> tip;
    in property <bool> on;
    in property <bool> compact;
    label: root.text;
    height: 30px;
    min-width: row.preferred-width + 22px;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-inner;
    background: root.on ? Theme.select : root.hot ? Theme.tint : transparent;
    private property <color> ink: root.on ? Theme.select-ink : root.hot ? Theme.ink : Theme.quiet;
    row := HorizontalLayout {
        x: 11px;
        width: self.preferred-width;
        spacing: root.compact ? 0px : 7px;
        Icon {
            cross-axis-self-alignment: center;
            glyph: root.glyph;
            size: 15px;
            tint: root.on ? Theme.select-ink : Theme.quiet;
        }
        if !root.compact: Text {
            text: root.text;
            font-size: 13px;
            color: root.ink;
            vertical-alignment: center;
        }
    }
    if root.tip != "": Tooltip {
        TipBody { text: root.tip; }
    }
}

export component TitleContent inherits HorizontalLayout {
    alignment: stretch;
    padding-left: 20px;
    spacing: 0px;
    // Brand: the pre-downscaled crystal mark at 7x20 and the name, in a 196 px column.
    HorizontalLayout {
        width: 196px;
        spacing: 10px;
        alignment: start;
        Image {
            y: (parent.height - 20px) / 2;
            width: 7px;
            height: 20px;
            source: @image-url("../assets/crystal-mark.png");
            accessible-role: none;
        }
        Text {
            text: "Crystal Launcher";
            font-size: 15px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }
    }
    Rectangle { width: 28px; }
    HorizontalLayout {
        spacing: 4px;
        horizontal-stretch: 0;
        NavTab { text: View.strings.home; active: View.page == 0; clicked => { View.navigate(0); } }
        NavTab { text: View.strings.friends; active: View.page == 1; clicked => { View.navigate(1); } }
        NavTab { text: View.strings.downloads; active: View.page == 2; clicked => { View.navigate(2); } }
        NavTab { text: View.strings.settings; active: View.page == 3; clicked => { View.navigate(3); } }
    }
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: center;
        BarButton {
            glyph: View.privacy ? Glyph.eye-off : Glyph.eye;
            text: View.strings.privacy;
            tip: View.privacy ? View.strings.privacy-on-tip : View.strings.privacy-off-tip;
            on: View.privacy;
            compact: View.compact;
            clicked => { View.toggle-privacy(); }
        }
    }
    Rectangle { width: 6px; }
    VerticalLayout {
        alignment: center;
        // One switch that names the theme it turns on.
        BarButton {
            glyph: Theme.light ? Glyph.moon : Glyph.sun;
            text: Theme.light ? View.strings.dark-theme : View.strings.light-theme;
            tip: View.compact ? self.text : "";
            compact: View.compact;
            clicked => { View.toggle-theme(); }
        }
    }
    Rectangle { width: 10px; }
}
