// The launcher features' page (src/features/ui.rs; src/slint_host/features.rs fills it): a
// two-pane page (a-skyline\features-dark.png) with one section per feature (windows with the
// monitor map, which is the window layout editor; hotkeys, crash recovery, backups, per-client
// performance and launch profiles,
// notifications, Discord and play time), the relaunch banner over the page's foot, and the
// background-gamepad line of the account sheet.
// Every string comes from Rust; every control sends a `Message::Feature` (or an existing core
// message for an account's own settings).
import { Theme } from "theme.slint";
import { Glyph, Icon, Dot, SmallButton, Control, Tone, Check, Select, Segmented, Rule, Spinner, Panel, KeyCap, Nav } from "widgets.slint";
import { Note, ErrorNote, SavedField } from "form.slint";
import { SectionTile, PageTitle, DetailTitle, GroupLabel, ToggleRow, PaneScroll } from "panes.slint";

/// The words that change only with the language.
export struct FeatureStrings {
    entry: string,
    caption: string,
    title: string,
    close: string,
    layouts: string,
    remember: string,
    remember-note: string,
    restore: string,
    restore-note: string,
    launch-saved: string,
    launch-saved-note: string,

    apply: string,
    restore-windows: string,
    monitor: string,
    grid: string,
    main-large: string,
    full-screen: string,
    map-note: string,
    in-game: string,
    remembered: string,
    no-layouts: string,
    forget: string,
    switch-windows: string,
    per-account: string,
    /// A hotkey field with no hotkey.
    hotkey-none: string,
    hotkey-note: string,
    no-accounts: string,
    recovery: string,
    offer: string,
    offer-note: string,
    auto-relaunch: string,
    auto-note: string,
    pending: string,
    no-pending: string,
    backups: string,
    back-up-now: string,
    before-update: string,
    keep: string,
    saved-backups: string,
    no-backups: string,
    restore-action: string,
    restore-question: string,
    cancel: string,
    background: string,
    background-priority: string,
    background-priority-note: string,
    mute-background: string,
    mute-background-note: string,
    priority: string,
    processors: string,
    processors-placeholder: string,
    mute-client: string,
    edit-account: string,
    running: string,
    notifications: string,
    notify: string,
    notify-mail: string,
    notify-friends: string,
    discord: string,
    discord-switch: string,
    playtime: string,
    record: string,
    no-playtime: string,
    relaunch: string,
    dismiss: string,
}

/// A remembered window: its account, its size and its display (`detail` is both, as one line).
export struct LayoutLine {
    name: string,
    detail: string,
    size: string,
    display: string,
}

/// A monitor on the map: its rectangle and its work area (the part the taskbar leaves), as
/// fractions of the map (the rectangle around every monitor).
export struct MapMonitor {
    x: float,
    y: float,
    w: float,
    h: float,
    work-x: float,
    work-y: float,
    work-w: float,
    work-h: float,
    /// Its number ("2"); empty with one monitor.
    name: string,
}

/// An account's window on the map: its place as fractions of the map.
export struct MapTile {
    index: string,
    name: string,
    size: string,
    x: float,
    y: float,
    w: float,
    h: float,
    /// The account is in game.
    live: bool,
    /// It has a place: an open window, or a remembered one. One with none is drawn faintly
    /// where Grid would put it.
    placed: bool,
    /// Moved on the map since its open window was: Apply moves the window.
    pending: bool,
}

/// A snap line shown while it holds the dragged tile, as fractions of the map.
export struct MapGuide {
    vertical: bool,
    at: float,
    from: float,
    to: float,
}
/// A hotkey field: what it does, the chord, and what to know about it (empty when nothing):
/// why it doesn't work, or (`warn`) what it clashes with while it does.
export struct HotkeyLine {
    name: string,
    text: string,
    /// Where it works, when that is not everywhere (an account's hotkey with no Ctrl, Alt or
    /// Win): said quietly, the hotkey is fine.
    note: string,
    problem: string,
    /// Registered and working.
    active: bool,
    /// `problem` is a warning: the hotkey works.
    warn: bool,
}

/// One account's client settings.
export struct ClientLine {
    name: string,
    running: bool,
    /// Index in `priorities` (0 is the Windows default).
    priority: int,
    processors: string,
    processors-error: string,
    mute: bool,
    profile: string,
    gamepad: string,
    /// The profile is missing: a launch refuses it.
    profile-missing: bool,
}

/// One saved backup.
export struct BackupLine {
    date: string,
    detail: string,
    confirming: bool,
    /// This backup is being restored.
    restoring: bool,
}

/// One client's play time.
export struct PlayLine {
    name: string,
    total: string,
    detail: string,
}

/// A relaunch the banner shows: scheduled (Cancel) or offered (Relaunch, Dismiss).
export struct RelaunchLine {
    text: string,
    scheduled: bool,
}

export global Features {
    in property <FeatureStrings> strings;
    in property <bool> open;
    /// The section titles, and under each its state in a few words (the first, Windows, is
    /// worded here from the layout and monitor chosen).
    in property <[string]> sections;
    in property <[string]> section-notes;
    in property <int> section;
    in property <string> notice;
    in property <bool> notice-error;
    // ---- windows ----
    in property <bool> remember;
    in property <bool> restore;
    in property <bool> launch-saved;

    /// The monitors the presets can fill: every monitor, then each one.
    in property <[string]> monitors;
    in-out property <int> monitor;
    /// The last Apply can be undone: one of the windows it moved is still open.
    in property <bool> can-restore;
    in property <[LayoutLine]> layouts;
    // The monitor map (the window layout editor): every monitor to scale, a tile per account.
    in property <[MapMonitor]> map-monitors;
    in property <[MapTile]> map-tiles;
    /// The snap lines holding the tile being dragged.
    in property <[MapGuide]> map-guides;
    /// Width over height of the map (the rectangle around every monitor).
    in property <float> map-aspect: 1.78;
    /// The selected tile, or -1.
    in property <int> map-selected: -1;
    /// Moves when the selected tile is to take the keyboard focus (it was pressed).
    in property <int> map-focus;
    /// The pointer over the map: 0 arrow, 1 move, 2 left-right, 3 up-down, 4 and 5 the diagonals.
    in property <int> map-cursor;
    /// The selected tile in words: its account, size and place.
    in property <string> map-readout;
    /// A game window is open (Apply shows), and a tile of one waits to be applied.
    in property <bool> can-apply;
    in property <bool> apply-pending;
    // ---- hotkeys: next and previous, then one per account ----
    in property <[HotkeyLine]> cycle-hotkeys;
    in property <[HotkeyLine]> account-hotkeys;
    /// The hotkey field that is recording (0 next window, 1 previous window, 2 + n the n-th
    /// account), or -1.
    in property <int> recording: -1;
    /// What it shows meanwhile: the prompt, or the modifiers held ("Ctrl+Alt+…").
    in property <string> recording-text;
    /// `recording-text` is the prompt (no modifier is held).
    in property <bool> recording-prompt;
    /// The host's keyboard hook took the key that ended the last recording: the field never
    /// saw its press, so that key's repeats arrive looking like new presses.
    in property <bool> recording-taken;
    // ---- recovery ----
    in property <bool> offer;
    in property <bool> auto-relaunch;
    in property <string> auto-note;
    // ---- backups ----
    /// A backup or a restore runs.
    in property <bool> busy;
    /// The running job is a backup (a restore shows on its row).
    in property <bool> backing-up;
    in property <bool> before-update;
    in property <[string]> keep-items;
    in property <int> keep;
    /// The saved backups are being listed.
    in property <bool> backups-loading;
    in property <[BackupLine]> backups;
    // ---- clients ----
    in property <bool> background-priority;
    in property <bool> mute-background;
    in property <[string]> priorities;
    in property <[ClientLine]> clients;
    // ---- activity ----
    in property <bool> notify;
    in property <bool> notify-mail;
    in property <bool> notify-friends;
    in property <bool> discord;
    in property <string> discord-status;
    /// 0 off, 1 connected, 2 waiting (Discord not running), 3 problem.
    in property <int> discord-state;
    in property <bool> record;
    in property <[PlayLine]> playtime;
    // ---- the relaunch banner and the account sheet ----
    in property <[RelaunchLine]> relaunches;
    in property <string> sheet-gamepad;
    /// Where the account sheet's body scrolls to (previews).
    in property <length> sheet-scroll;
    /// Where the open section scrolls to (previews).
    in property <length> page-scroll;

    callback open-sheet(bool);
    callback section-picked(int);
    /// 0 remember, 1 restore, 2 launch at saved size, 3 offer relaunch, 4 automatic relaunch,
    /// 5 back up before updates, 6 notifications, 7 mail, 8 friends online, 9 background
    /// priority, 10 mute background clients, 11 record play time, 12 Discord.
    callback toggle(int, bool);
    /// A hotkey field starts recording: 0 next window, 1 previous window, 2 + n the n-th account.
    callback hotkey-record(int);
    /// The pointer went down on that field (a press anywhere else ends a recording).
    callback hotkey-pointer(int);
    /// That field lost the focus.
    callback hotkey-blur(int);
    /// A key event in the recording field, for when the host's keyboard hook is not in: the
    /// key's text, Ctrl, Alt, Shift and the Windows key held, and pressed or released. Whether
    /// the key was the recording's.
    callback hotkey-key(string, bool, bool, bool, bool, bool) -> bool;
    /// The pointer on the map: 0 pressed, 1 moved, 2 released, 3 the press was taken away; where
    /// it is as fractions of the map, how wide the map is drawn, and whether Alt is held.
    callback map-pointer(int, float, float, length, bool);
    /// A tile took or lost the keyboard focus.
    callback tile-focused(int);
    callback tile-blurred(int);
    /// A key on the focused tile: its text, Shift held, and pressed or released. Whether the
    /// tile used it (the arrows move it, Return goes to the next tile under it).
    callback tile-key(int, string, bool, bool) -> bool;
    /// Fill the tiles: 0 grid, 1 main large, 2 full screen, on `monitor`.
    callback preset(int);
    /// Move the open game windows to their tiles.
    callback apply-layout();
    /// Put the windows the last Apply moved back where they were.
    callback restore-windows();
    callback forget(int);
    callback relaunch-cancel(int);
    callback relaunch-now(int);
    callback relaunch-dismiss(int);
    callback back-up-now();
    callback restore-ask(int);
    callback restore-confirm();
    callback restore-cancel();
    callback keep-picked(int);
    callback priority-picked(int, int);
    callback processors-entered(int, string);
    callback mute-client(int, bool);
    callback edit-account(int);
}

/// A card row's two lines: a name and a quiet detail.
component TwoLines inherits VerticalLayout {
    in property <string> name;
    in property <string> detail;
    in property <bool> mono-name;
    in property <bool> mono-detail;
    horizontal-stretch: 1;
    alignment: center;
    spacing: 2px;
    Text {
        text: root.name;
        font-family: root.mono-name ? Theme.mono : Theme.sans;
        font-size: root.mono-name ? Theme.type-small : Theme.type-body;
        font-weight: root.mono-name ? 400 : 500;
        color: Theme.ink;
        overflow: elide;
    }
    Text {
        text: root.detail;
        font-family: root.mono-detail ? Theme.mono : Theme.sans;
        font-size: Theme.type-note;
        color: Theme.sub;
        overflow: elide;
    }
}

/// A list row: a hairline above, the content inset 9 px.
component ListRow inherits Rectangle {
    in property <bool> closing;
    min-height: 48px;
    Rule { y: 0px; width: parent.width; }
    VerticalLayout {
        padding-top: Theme.card-row-y;
        padding-bottom: Theme.card-row-y;
        @children
    }
    if root.closing: Rule { y: parent.height - 1px; width: parent.width; }
}

/// A hotkey, set by pressing it. A click, Return or Space starts recording: the field shows
/// `live` (the prompt, then the modifiers as they are held) and the next key pressed with them
/// is the hotkey. The host's keyboard hook takes the keys while it records; a key that
/// reaches the field all the same (the hook is not in, or was not called) goes to `key`.
component HotkeyField inherits Rectangle {
    in property <string> label;
    /// The hotkey ("" for none: `none` shows).
    in property <string> chord;
    in property <string> none;
    in property <bool> recording;
    in property <string> live;
    in property <bool> prompt;
    callback record();
    callback pointer();
    callback blur();
    callback key(string, bool, bool, bool, bool, bool) -> bool;
    /// A recording just ended and the key that ended it is still down: until a key is let go,
    /// its repeats are nobody's, and Return or Space starts no new recording (a repeat of a key
    /// the host's hook took is not marked as one).
    private property <bool> settling;
    height: Theme.control-h;
    horizontal-stretch: 0;
    border-radius: Theme.radius-mid;
    border-width: 1px;
    background: root.recording ? Theme.select : Theme.field;
    border-color: root.recording || focus.has-focus ? Theme.accent : hit.has-hover ? Theme.line.mix(Theme.accent, 0.5) : Theme.line;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.recording ? root.live : root.chord == "" ? root.none : root.chord;
    accessible-action-default => { root.record(); }
    forward-focus: focus;
    changed recording => {
        if !root.recording && Features.recording-taken { root.settling = true; }
    }
    focus := FocusScope {
        focus-on-click: false;
        focus-gained(reason) => { Nav.keyboard = reason == FocusReason.tab-navigation; }
        focus-lost => {
            root.settling = false;
            root.blur();
        }
        key-pressed(event) => {
            if root.recording {
                if event.repeat { return accept; }
                if root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, true) {
                    root.settling = true;
                    return accept;
                }
                return reject;
            }
            if event.repeat { return root.settling ? accept : reject; }
            if event.text == Key.Return || event.text == " " {
                if !root.settling { root.record(); }
                return accept;
            }
            root.settling = false;
            return reject;
        }
        key-released(event) => {
            root.settling = false;
            if root.recording {
                root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, false);
                return accept;
            }
            return reject;
        }
    }
    hit := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.pointer(); }
        }
        clicked => {
            focus.focus();
            root.record();
        }
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 8px;
        spacing: Theme.sp-s;
        Text {
            horizontal-stretch: 1;
            text: root.recording ? root.live : root.chord == "" ? root.none : root.chord;
            font-family: (root.recording && root.prompt) || (!root.recording && root.chord == "") ? Theme.sans : Theme.mono;
            font-size: (root.recording && root.prompt) || (!root.recording && root.chord == "") ? Theme.type-small : 12px;
            font-weight: root.recording ? 500 : 400;
            color: root.recording ? Theme.select-ink : root.chord == "" ? Theme.faint : Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.recording: KeyCap {
            cross-axis-self-alignment: center;
            text: "Esc";
            ink: Theme.select-ink;
            edge: Theme.select-ink.with-alpha(0.4);
        }
    }
    if focus.has-focus && Nav.keyboard && !root.recording: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

/// A hotkey row: what it does, the hotkey's field with what to know about it under it, and its
/// state.
component HotkeyRow inherits Rectangle {
    in property <HotkeyLine> line;
    in property <string> none;
    in property <bool> recording;
    in property <bool> closing;
    callback record();
    callback pointer();
    callback blur();
    min-height: 48px;
    Rule { y: 0px; width: parent.width; }
    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: Theme.sp-xs;
        HorizontalLayout {
            spacing: 16px;
            // The field is narrower in the small window, so the name keeps its words; the fields
            // stay one column.
            Text {
                horizontal-stretch: 1;
                text: root.line.name;
                font-size: Theme.type-body;
                font-weight: 500;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            HotkeyField {
                width: Theme.small ? 150px : 200px;
                label: root.line.name;
                chord: root.line.text;
                none: root.none;
                recording: root.recording;
                live: Features.recording-text;
                prompt: Features.recording-prompt;
                record => { root.record(); }
                pointer => { root.pointer(); }
                blur => { root.blur(); }
                key(text, control, alt, shift, meta, down) => { return Features.hotkey-key(text, control, alt, shift, meta, down); }
            }
            VerticalLayout {
                width: 16px;
                horizontal-stretch: 0;
                alignment: center;
                if root.line.text != "" || root.line.problem != "": Icon {
                    glyph: root.line.problem == "" ? Glyph.check-circle : Glyph.alert-circle;
                    size: 16px;
                    tint: root.line.problem != "" ? (root.line.warn ? Theme.warn : Theme.danger) : root.line.active ? Theme.ok : Theme.faint;
                }
            }
        }
        if root.line.note != "" && !root.recording: Note { text: root.line.note; }
        if root.line.problem != "" && !root.recording: ErrorNote {
            text: root.line.problem;
            color: root.line.warn ? Theme.warn : Theme.danger;
        }
    }
    if root.closing: Rule { y: parent.height - 1px; width: parent.width; }
}

/// A tile's face on the monitor map (`.mon`): its number, its account and its size, and In game
/// under them when there is room. The selected one is ringed in ice; one with no place yet is
/// drawn faintly; one whose open window Apply has not moved yet carries an amber dot.
component TileFace inherits Rectangle {
    in property <MapTile> tile;
    in property <bool> selected;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.selected ? Theme.ice : !root.tile.placed ? Theme.line.with-alpha(0.6) : Theme.line;
    background: !root.tile.placed ? Theme.fill.with-alpha(0.35) : root.selected ? Theme.fill2 : Theme.fill;
    clip: true;
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        spacing: 1px;
        alignment: start;
        HorizontalLayout {
            spacing: 6px;
            Text {
                horizontal-stretch: 0;
                height: 16px;
                text: root.tile.index;
                font-family: Theme.mono;
                font-size: Theme.type-micro;
                font-weight: 500;
                color: root.tile.live || root.selected ? Theme.ice : Theme.faint;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                height: 16px;
                text: root.tile.name;
                font-size: Theme.type-note;
                font-weight: 600;
                color: !root.tile.placed ? Theme.faint : root.tile.live || root.selected ? Theme.ink : Theme.ink2;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.tile.pending: Dot { cross-axis-self-alignment: center; size: 6px; tint: Theme.warn; }
        }
        if root.height > 42px: Text {
            height: 14px;
            text: root.tile.size;
            font-family: Theme.mono;
            font-size: 10.5px;
            font-weight: 500;
            color: Theme.faint;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.tile.live && root.height > 66px: VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 6px;
        alignment: end;
        Text {
            height: 16px;
            text: Features.strings.in-game;
            font-size: Theme.type-caption;
            font-weight: 600;
            color: Theme.ice-hi;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

/// The monitor map, which is the window layout editor: every monitor to scale where Windows has
/// it, its taskbar's strip a shade apart, and a tile per account where its game window is or
/// will open. A tile is dragged to move it and by an edge or corner to resize it (the host
/// snaps it and says which lines hold it); the arrow keys move the selected one a pixel.
/// Everything is drawn on whole pixels.
component MonitorMap inherits Rectangle {
    height: Theme.small ? 252px : 300px;
    border-radius: Theme.radius;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    accessible-role: none;
    private property <length> pad: 14px;
    private property <length> fit-w: floor(min(root.width - 2 * root.pad, (root.height - 2 * root.pad) * Features.map-aspect) / 1px) * 1px;
    private property <length> fit-h: root.fit-w / Features.map-aspect;
    private property <length> ox: round((root.width - root.fit-w) / 2px) * 1px;
    private property <length> oy: round((root.height - root.fit-h) / 2px) * 1px;
    /// Where the fraction `f` of the map's width (height) is, on a whole pixel.
    pure function at-x(f: float) -> length { return round((root.ox + f * root.fit-w) / 1px) * 1px; }
    pure function at-y(f: float) -> length { return round((root.oy + f * root.fit-h) / 1px) * 1px; }
    function point(kind: int, alt: bool) {
        Features.map-pointer(kind, (area.mouse-x - root.ox) / root.fit-w, (area.mouse-y - root.oy) / root.fit-h, root.fit-w, alt);
    }
    if Features.map-tiles.length == 0: Text {
        text: Features.strings.no-accounts;
        font-size: Theme.type-note;
        color: Theme.faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for monitor in Features.map-monitors: Rectangle {
        x: root.at-x(monitor.x);
        y: root.at-y(monitor.y);
        width: root.at-x(monitor.x + monitor.w) - self.x;
        height: root.at-y(monitor.y + monitor.h) - self.y;
        // The taskbar's strip shows as what the work area leaves of the monitor.
        background: Theme.line;
        Rectangle {
            x: root.at-x(monitor.work-x) - parent.x;
            y: root.at-y(monitor.work-y) - parent.y;
            width: root.at-x(monitor.work-x + monitor.work-w) - root.at-x(monitor.work-x);
            height: root.at-y(monitor.work-y + monitor.work-h) - root.at-y(monitor.work-y);
            background: Theme.bg;
        }
        Rectangle {
            border-width: 1px;
            border-color: Theme.line;
        }
        if monitor.name != "": HorizontalLayout {
            padding-right: 7px;
            padding-bottom: 5px;
            alignment: end;
            VerticalLayout {
                alignment: end;
                Text {
                    text: monitor.name;
                    font-family: Theme.mono;
                    font-size: Theme.type-micro;
                    font-weight: 500;
                    color: Theme.faint;
                }
            }
        }
    }
    for tile[index] in Features.map-tiles: Rectangle {
        // A pixel inside its rectangle all round, so tiles that abut show a hairline between
        // them and a full-screen one leaves its monitor's outline.
        x: root.at-x(tile.x) + 1px;
        y: root.at-y(tile.y) + 1px;
        width: max(6px, root.at-x(tile.x + tile.w) - 1px - self.x);
        height: max(6px, root.at-y(tile.y + tile.h) - 1px - self.y);
        accessible-role: button;
        accessible-label: tile.name;
        accessible-description: tile.size;
        property <int> take-focus: Features.map-focus;
        changed take-focus => {
            if Features.map-selected == index { scope.focus(); }
        }
        TileFace { tile: tile; }
        scope := FocusScope {
            focus-on-click: false;
            focus-gained(reason) => {
                Nav.keyboard = reason == FocusReason.tab-navigation;
                Features.tile-focused(index);
            }
            focus-lost => { Features.tile-blurred(index); }
            key-pressed(event) => { return Features.tile-key(index, event.text, event.modifiers.shift, true) ? accept : reject; }
            key-released(event) => { return Features.tile-key(index, event.text, event.modifiers.shift, false) ? accept : reject; }
        }
        if scope.has-focus && Nav.keyboard: Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: 6px;
            border-width: 2px;
            border-color: Theme.accent;
        }
    }
    // The selected tile again, over the others, with its corner handles.
    if Features.map-selected >= 0 && Features.map-selected < Features.map-tiles.length: Rectangle {
        property <MapTile> tile: Features.map-tiles[Features.map-selected];
        x: root.at-x(self.tile.x) + 1px;
        y: root.at-y(self.tile.y) + 1px;
        width: max(6px, root.at-x(self.tile.x + self.tile.w) - 1px - self.x);
        height: max(6px, root.at-y(self.tile.y + self.tile.h) - 1px - self.y);
        TileFace { tile: parent.tile; selected: true; }
        for corner in 4: Rectangle {
            x: mod(corner, 2) == 0 ? -2px : parent.width - 3px;
            y: corner < 2 ? -2px : parent.height - 3px;
            width: 5px;
            height: 5px;
            border-radius: 1px;
            background: Theme.ice;
        }
    }
    for guide in Features.map-guides: Rectangle {
        x: guide.vertical ? root.at-x(guide.at) : root.at-x(guide.from);
        y: guide.vertical ? root.at-y(guide.from) : root.at-y(guide.at);
        width: guide.vertical ? 1px : root.at-x(guide.to) - self.x;
        height: guide.vertical ? root.at-y(guide.to) - self.y : 1px;
        background: Theme.ice-hi;
    }
    area := TouchArea {
        mouse-cursor: Features.map-cursor == 1 ? MouseCursor.move
            : Features.map-cursor == 2 ? MouseCursor.ew-resize
            : Features.map-cursor == 3 ? MouseCursor.ns-resize
            : Features.map-cursor == 4 ? MouseCursor.nwse-resize
            : Features.map-cursor == 5 ? MouseCursor.nesw-resize
            : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.point(0, event.modifiers.alt);
            } else if event.kind == PointerEventKind.move {
                root.point(1, event.modifiers.alt);
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.point(2, event.modifiers.alt);
            } else if event.kind == PointerEventKind.cancel {
                root.point(3, false);
            }
        }
    }
}

/// A label over a control (`.fl`).
component FieldLabel inherits Text {
    height: 18px;
    font-size: Theme.type-note;
    color: Theme.sub;
    vertical-alignment: center;
}

/// The layouts the tiles start from: one press fills them.
component PresetButtons inherits HorizontalLayout {
    spacing: Theme.sp-s;
    SmallButton { cross-axis-self-alignment: center; scale: 1; glyph: Glyph.grid; text: Features.strings.grid; clicked => { Features.preset(0); } }
    SmallButton { cross-axis-self-alignment: center; scale: 1; glyph: Glyph.window; text: Features.strings.main-large; clicked => { Features.preset(1); } }
    SmallButton { cross-axis-self-alignment: center; scale: 1; glyph: Glyph.monitor; text: Features.strings.full-screen; clicked => { Features.preset(2); } }
}

component WindowsSection inherits VerticalLayout {
    spacing: Theme.sp-3;
    VerticalLayout {
        spacing: Theme.sp-m;
        DetailTitle { text: Features.sections[0]; }
        // The presets and the monitor they fill on one line when the pane has the room.
        if root.width >= 520px: HorizontalLayout {
            spacing: Theme.sp-s;
            PresetButtons { }
            Rectangle { horizontal-stretch: 1; }
            Select {
                width: 232px;
                label: Features.strings.monitor;
                items: Features.monitors;
                current: Features.monitor;
                picked(index) => { Features.monitor = index; }
            }
        }
        if root.width < 520px: VerticalLayout {
            spacing: Theme.sp-s;
            HorizontalLayout {
                PresetButtons { }
                Rectangle { horizontal-stretch: 1; }
            }
            Select {
                label: Features.strings.monitor;
                items: Features.monitors;
                current: Features.monitor;
                picked(index) => { Features.monitor = index; }
            }
        }
        MonitorMap { }
        HorizontalLayout {
            spacing: Theme.sp-s;
            min-height: Theme.control-h;
            // The selected tile in words; how the map is used while none is selected.
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: Features.map-readout != "" ? Features.map-readout : Features.strings.map-note;
                font-size: Theme.type-note;
                color: Features.map-readout != "" ? Theme.sub : Theme.faint;
                vertical-alignment: center;
                overflow: elide;
            }
            if Features.can-restore: Control {
                cross-axis-self-alignment: center;
                tone: Tone.secondary;
                glyph: Glyph.window;
                text: Features.strings.restore-windows;
                clicked => { Features.restore-windows(); }
            }
            if Features.can-apply: Control {
                cross-axis-self-alignment: center;
                tone: Tone.primary;
                glyph: Glyph.check;
                text: Features.strings.apply;
                enabled: Features.apply-pending;
                clicked => { Features.apply-layout(); }
            }
        }
    }
    VerticalLayout {
        ToggleRow { name: Features.strings.remember; on: Features.remember; toggled(on) => { Features.toggle(0, on); } }
        ToggleRow { name: Features.strings.restore; note: Features.strings.restore-note; on: Features.restore; toggled(on) => { Features.toggle(1, on); } }
        ToggleRow { name: Features.strings.launch-saved; on: Features.launch-saved; closing: true; toggled(on) => { Features.toggle(2, on); } }
    }
    VerticalLayout {
        spacing: Theme.sp-s;
        GroupLabel { text: Features.strings.remembered; }
        if Features.layouts.length == 0: Note { text: Features.strings.no-layouts; }
        VerticalLayout {
            for line[index] in Features.layouts: ListRow {
                closing: index == Features.layouts.length - 1;
                HorizontalLayout {
                    spacing: Theme.sp-s;
                    Text { width: 176px; text: line.name; font-size: Theme.type-body; font-weight: 500; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                    Text { width: 104px; text: line.size; font-family: Theme.mono; font-size: Theme.type-caption; font-weight: 500; color: Theme.sub; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; text: line.display; font-family: Theme.mono; font-size: Theme.type-caption; font-weight: 500; color: Theme.faint; vertical-alignment: center; overflow: elide; }
                    SmallButton {
                        cross-axis-self-alignment: center;
                        scale: 1;
                        text: Features.strings.forget;
                        clicked => { Features.forget(index); }
                    }
                }
            }
        }
    }
}

component HotkeysSection inherits VerticalLayout {
    spacing: Theme.sp-3;
    VerticalLayout {
        spacing: Theme.sp-l;
        DetailTitle { text: Features.sections[1]; }
        VerticalLayout {
            spacing: Theme.sp-s;
            GroupLabel { text: Features.strings.switch-windows; }
            VerticalLayout {
                for line[index] in Features.cycle-hotkeys: HotkeyRow {
                    line: line;
                    none: Features.strings.hotkey-none;
                    recording: Features.recording == index;
                    closing: index == Features.cycle-hotkeys.length - 1;
                    record => { Features.hotkey-record(index); }
                    pointer => { Features.hotkey-pointer(index); }
                    blur => { Features.hotkey-blur(index); }
                }
            }
            Note { text: Features.strings.hotkey-note; }
        }
    }
    VerticalLayout {
        spacing: Theme.sp-s;
        GroupLabel { text: Features.strings.per-account; }
        if Features.account-hotkeys.length == 0: Note { text: Features.strings.no-accounts; }
        VerticalLayout {
            for line[index] in Features.account-hotkeys: HotkeyRow {
                line: line;
                none: Features.strings.hotkey-none;
                recording: Features.recording == index + 2;
                closing: index == Features.account-hotkeys.length - 1;
                record => { Features.hotkey-record(index + 2); }
                pointer => { Features.hotkey-pointer(index + 2); }
                blur => { Features.hotkey-blur(index + 2); }
            }
        }
    }
}

/// The relaunches waiting: one row each, with its buttons. `scale` is Home's layout scale in
/// the banner, 1 on the page.
component RelaunchList inherits VerticalLayout {
    in property <float> scale: 1;
    spacing: Theme.sp-s * root.scale;
    for line[index] in Features.relaunches: HorizontalLayout {
        spacing: Theme.sp-m * root.scale;
        Dot { cross-axis-self-alignment: center; tint: line.scheduled ? Theme.info : Theme.warn; }
        Text {
            horizontal-stretch: 1;
            text: line.text;
            font-size: Theme.type-small * root.scale;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        if line.scheduled: SmallButton { cross-axis-self-alignment: center; scale: root.scale; text: Features.strings.cancel; clicked => { Features.relaunch-cancel(index); } }
        if !line.scheduled: SmallButton { cross-axis-self-alignment: center; scale: root.scale; soft: true; glyph: Glyph.play; text: Features.strings.relaunch; clicked => { Features.relaunch-now(index); } }
        if !line.scheduled: SmallButton { cross-axis-self-alignment: center; scale: root.scale; text: Features.strings.dismiss; clicked => { Features.relaunch-dismiss(index); } }
    }
}

component RecoverySection inherits VerticalLayout {
    spacing: Theme.sp-3;
    VerticalLayout {
        spacing: Theme.sp-l;
        DetailTitle { text: Features.sections[2]; }
        VerticalLayout {
            ToggleRow { name: Features.strings.offer; note: Features.strings.offer-note; on: Features.offer; toggled(on) => { Features.toggle(3, on); } }
            ToggleRow { name: Features.strings.auto-relaunch; note: Features.auto-note; on: Features.auto-relaunch; closing: true; toggled(on) => { Features.toggle(4, on); } }
        }
    }
    VerticalLayout {
        spacing: Theme.sp-s;
        GroupLabel { text: Features.strings.pending; }
        if Features.relaunches.length == 0: Note { text: Features.strings.no-pending; }
        if Features.relaunches.length > 0: RelaunchList { }
    }
}

component BackupsSection inherits VerticalLayout {
    spacing: Theme.sp-3;
    VerticalLayout {
        spacing: Theme.sp-l;
        DetailTitle { text: Features.sections[3]; }
        HorizontalLayout {
            alignment: start;
            Control {
                tone: Tone.primary;
                text: Features.strings.back-up-now;
                glyph: Glyph.download;
                busy: Features.backing-up;
                enabled: !Features.busy;
                clicked => { Features.back-up-now(); }
            }
        }
        VerticalLayout {
            ToggleRow { name: Features.strings.before-update; on: Features.before-update; toggled(on) => { Features.toggle(5, on); } }
            Rectangle {
                height: 52px;
                Rule { y: 0px; width: parent.width; }
                HorizontalLayout {
                    spacing: 16px;
                    Text { horizontal-stretch: 1; text: Features.strings.keep; font-size: Theme.type-body; font-weight: 500; color: Theme.ink; vertical-alignment: center; }
                    Select {
                        cross-axis-self-alignment: center;
                        width: 180px;
                        label: Features.strings.keep;
                        items: Features.keep-items;
                        current: Features.keep;
                        picked(index) => { Features.keep-picked(index); }
                    }
                }
                Rule { y: parent.height - 1px; width: parent.width; }
            }
        }
    }
    VerticalLayout {
        spacing: Theme.sp-s;
        GroupLabel { text: Features.strings.saved-backups; }
        // Nothing while the list loads, so a list that exists never reads as empty.
        if Features.backups-loading: HorizontalLayout {
            alignment: start;
            Spinner { }
        }
        if !Features.backups-loading && Features.backups.length == 0: Note { text: Features.strings.no-backups; }
        VerticalLayout {
            for line[index] in Features.backups: backup := ListRow {
                closing: index == Features.backups.length - 1;
                VerticalLayout {
                    spacing: Theme.sp-s;
                    HorizontalLayout {
                        spacing: Theme.sp-m;
                        TwoLines { name: line.date; detail: line.detail; mono-name: true; }
                        SmallButton {
                            cross-axis-self-alignment: center;
                            scale: 1;
                            text: Features.strings.restore-action;
                            busy: line.restoring;
                            enabled: !Features.busy && !line.confirming;
                            // The confirmation below holds the one Restore while it shows.
                            visible: !line.confirming;
                            clicked => { Features.restore-ask(index); }
                        }
                    }
                    if line.confirming: VerticalLayout {
                        spacing: Theme.sp-s;
                        // Measured at the row's width, so its wrapped lines push the buttons down.
                        Note { preferred-width: backup.width; text: Features.strings.restore-question; color: Theme.ink2; }
                        HorizontalLayout {
                            spacing: Theme.sp-s;
                            alignment: end;
                            SmallButton { scale: 1; text: Features.strings.cancel; enabled: !Features.busy; clicked => { Features.restore-cancel(); } }
                            SmallButton { scale: 1; danger: true; text: Features.strings.restore-action; enabled: !Features.busy; clicked => { Features.restore-confirm(); } }
                        }
                    }
                }
            }
        }
    }
}

component ClientsSection inherits VerticalLayout {
    spacing: Theme.sp-3;
    VerticalLayout {
        spacing: Theme.sp-l;
        DetailTitle { text: Features.sections[4]; }
        VerticalLayout {
            ToggleRow { name: Features.strings.background-priority; note: Features.strings.background-priority-note; on: Features.background-priority; toggled(on) => { Features.toggle(9, on); } }
            ToggleRow { name: Features.strings.mute-background; note: Features.strings.mute-background-note; on: Features.mute-background; closing: true; toggled(on) => { Features.toggle(10, on); } }
        }
    }
    VerticalLayout {
        spacing: Theme.sp-s;
        GroupLabel { text: Features.strings.per-account; }
        if Features.clients.length == 0: Note { text: Features.strings.no-accounts; }
        VerticalLayout {
            spacing: Theme.sp-m;
            for line[index] in Features.clients: Panel {
                VerticalLayout {
                    padding: 14px;
                    spacing: Theme.sp-m;
                    HorizontalLayout {
                        spacing: Theme.sp-s;
                        Text { text: line.name; font-size: Theme.type-body; font-weight: 600; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                        if line.running: Dot { cross-axis-self-alignment: center; tint: Theme.info; }
                        if line.running: Text { text: Features.strings.running; font-size: Theme.type-caption; color: Theme.sub; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    // Side by side; one over the other in the small window, where two columns
                    // would cut the priority's name.
                    if !Theme.small: HorizontalLayout {
                        spacing: Theme.sp-m;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            FieldLabel { text: Features.strings.priority; }
                            Select {
                                label: Features.strings.priority;
                                items: Features.priorities;
                                current: line.priority;
                                picked(choice) => { Features.priority-picked(index, choice); }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            FieldLabel { text: Features.strings.processors; }
                            SavedField {
                                label: Features.strings.processors;
                                placeholder: Features.strings.processors-placeholder;
                                saved: line.processors;
                                commit(text) => { Features.processors-entered(index, text); }
                            }
                        }
                    }
                    if Theme.small: VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: Features.strings.priority; }
                        Select {
                            label: Features.strings.priority;
                            items: Features.priorities;
                            current: line.priority;
                            picked(choice) => { Features.priority-picked(index, choice); }
                        }
                    }
                    if Theme.small: VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: Features.strings.processors; }
                        SavedField {
                            label: Features.strings.processors;
                            placeholder: Features.strings.processors-placeholder;
                            saved: line.processors;
                            commit(text) => { Features.processors-entered(index, text); }
                        }
                    }
                    if line.processors-error != "": ErrorNote { text: line.processors-error; }
                    Check {
                        text: Features.strings.mute-client;
                        checked: line.mute;
                        toggled(on) => { Features.mute-client(index, on); }
                    }
                    Rule { }
                    HorizontalLayout {
                        spacing: Theme.sp-m;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: line.profile; font-size: Theme.type-small; color: line.profile-missing ? Theme.danger : Theme.ink2; wrap: word-wrap; }
                            if line.gamepad != "": Note { text: line.gamepad; }
                        }
                        if !Theme.small: SmallButton {
                            cross-axis-self-alignment: center;
                            scale: 1;
                            glyph: Glyph.edit;
                            text: Features.strings.edit-account;
                            clicked => { Features.edit-account(index); }
                        }
                    }
                    // Under the summary in the small window.
                    if Theme.small: HorizontalLayout {
                        alignment: start;
                        SmallButton {
                            scale: 1;
                            glyph: Glyph.edit;
                            text: Features.strings.edit-account;
                            clicked => { Features.edit-account(index); }
                        }
                    }
                }
            }
        }
    }
}

component ActivitySection inherits VerticalLayout {
    spacing: Theme.sp-3;
    VerticalLayout {
        spacing: Theme.sp-l;
        DetailTitle { text: Features.sections[5]; }
        VerticalLayout {
            spacing: Theme.sp-s;
            GroupLabel { text: Features.strings.notifications; }
            VerticalLayout {
                ToggleRow { name: Features.strings.notify; on: Features.notify; toggled(on) => { Features.toggle(6, on); } }
                ToggleRow { inset: Theme.sp-l; name: Features.strings.notify-mail; on: Features.notify-mail; enabled: Features.notify; toggled(on) => { Features.toggle(7, on); } }
                ToggleRow { inset: Theme.sp-l; name: Features.strings.notify-friends; on: Features.notify-friends; enabled: Features.notify; closing: true; toggled(on) => { Features.toggle(8, on); } }
            }
        }
    }
    VerticalLayout {
        spacing: Theme.sp-s;
        GroupLabel { text: Features.strings.discord; }
        VerticalLayout {
            ToggleRow { name: Features.strings.discord-switch; on: Features.discord; closing: true; toggled(on) => { Features.toggle(12, on); } }
        }
        if Features.discord-status != "": HorizontalLayout {
            spacing: Theme.sp-s;
            Dot {
                cross-axis-self-alignment: center;
                tint: Features.discord-state == 1 ? Theme.ok : Features.discord-state == 3 ? Theme.danger : Features.discord-state == 2 ? Theme.warn : Theme.faint;
            }
            Note { horizontal-stretch: 1; text: Features.discord-status; vertical-alignment: center; }
        }
    }
    VerticalLayout {
        spacing: Theme.sp-s;
        GroupLabel { text: Features.strings.playtime; }
        VerticalLayout {
            ToggleRow { name: Features.strings.record; on: Features.record; closing: Features.playtime.length == 0; toggled(on) => { Features.toggle(11, on); } }
            for line[index] in Features.playtime: played := ListRow {
                closing: index == Features.playtime.length - 1;
                // The total on the name's line; the detail under them has the row's width.
                VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: Theme.sp-m;
                        Text { horizontal-stretch: 1; min-width: 0px; text: line.name; font-size: Theme.type-body; font-weight: 500; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                        Text { text: line.total; font-family: Theme.mono; font-size: Theme.type-small; color: Theme.ink2; vertical-alignment: center; }
                    }
                    Text { preferred-width: played.width; text: line.detail; font-size: Theme.type-note; color: Theme.sub; wrap: word-wrap; }
                }
            }
        }
        if Features.playtime.length == 0: Note { text: Features.strings.no-playtime; }
    }
}

/// The Features page: its title (and the last outcome at the right), the section tiles, and the
/// open section's detail.
export component FeaturesPage inherits Rectangle {
    VerticalLayout {
        padding-top: Theme.sp-3;
        padding-left: Theme.page-x;
        // The detail scroller keeps its lane beyond the page margin.
        padding-right: Theme.page-x - 12px;
        spacing: Theme.sp-3;
        HorizontalLayout {
            height: 32px;
            padding-right: 12px;
            spacing: Theme.sp-m;
            PageTitle { horizontal-stretch: 0; text: Features.strings.title; }
            Rectangle { horizontal-stretch: 1; }
            if Features.notice != "": HorizontalLayout {
                horizontal-stretch: 0;
                spacing: Theme.sp-s;
                Icon {
                    cross-axis-self-alignment: center;
                    glyph: Features.notice-error ? Glyph.alert-circle : Glyph.check-circle;
                    size: 16px;
                    tint: Features.notice-error ? Theme.danger : Theme.ok;
                }
                Text {
                    max-width: 420px;
                    text: Features.notice;
                    font-size: Theme.type-small;
                    color: Features.notice-error ? Theme.danger : Theme.ink2;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.small ? 28px : Theme.page-x;
            VerticalLayout {
                horizontal-stretch: 0;
                width: Theme.small ? 232px : 288px;
                spacing: 4px;
                alignment: start;
                for title[i] in Features.sections: SectionTile {
                    glyph: i == 0 ? Glyph.window : i == 1 ? Glyph.keyboard : i == 2 ? Glyph.shield : i == 3 ? Glyph.archive : i == 4 ? Glyph.cpu : Glyph.clock;
                    title: title;
                    note: Features.section-notes[i];
                    active: i == Features.section;
                    clicked => { Features.section-picked(i); }
                }
            }
            PaneScroll {
                horizontal-stretch: 1;
                scroll-to: Features.page-scroll;
                // A drag on the monitor map moves a tile: the wheel scrolls the pane.
                drag-pan: false;
                if Features.section == 0: WindowsSection { }
                if Features.section == 1: HotkeysSection { }
                if Features.section == 2: RecoverySection { }
                if Features.section == 3: BackupsSection { }
                if Features.section == 4: ClientsSection { }
                if Features.section == 5: ActivitySection { }
            }
        }
    }
}

/// Over the page's foot while a relaunch is scheduled or offered; it scales with Home.
export component RelaunchBanner inherits VerticalLayout {
    Rule { tint: Theme.chrome-line; }
    Rectangle {
        background: Theme.tint;
        HorizontalLayout {
            padding-left: Theme.page-x * Theme.scale;
            padding-right: Theme.page-x * Theme.scale;
            padding-top: 10px * Theme.scale;
            padding-bottom: 10px * Theme.scale;
            RelaunchList { scale: Features.open ? 1 : Theme.scale; }
        }
    }
}
